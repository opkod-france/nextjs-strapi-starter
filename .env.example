# ─── Database (PostgreSQL) ───────────────────────
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# ─── Strapi Secrets (auto-generated by scripts/setup.sh) ──
JWT_SECRET=
ADMIN_JWT_SECRET=
APP_KEYS=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=

# ─── Strapi Server ──────────────────────────────
HOST=0.0.0.0
PORT=1337

# ─── ImageKit (Upload Provider) ─────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/strapi

# ─── Brevo (Email Provider) ─────────────────────
BREVO_API_KEY=
EMAIL_DEFAULT_FROM=noreply@example.com
EMAIL_DEFAULT_REPLY_TO=noreply@example.com

# ─── Domains ────────────────────────────────────
# Local development (used by Traefik in docker-compose.yml)
LOCAL_DOMAIN=app.localhost
LOCAL_API_DOMAIN=api.localhost

# Production (used by docker-compose.prod.yml)
WEB_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# ─── Ports (local dev, all configurable) ────────
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# ─── Next.js ────────────────────────────────────
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
